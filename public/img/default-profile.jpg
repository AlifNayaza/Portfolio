<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141417" />
      <stop offset="50%" stop-color="#1f1f26" />
      <stop offset="100%" stop-color="#0e0e11" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff334b" />
      <stop offset="100%" stop-color="#e0112d" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="500" fill="url(#bgGrad)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.15" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="100" x2="400" y2="100" stroke-dasharray="4,4" />
    <line x1="0" y1="200" x2="400" y2="200" stroke-dasharray="4,4" />
    <line x1="0" y1="300" x2="400" y2="300" stroke-dasharray="4,4" />
    <line x1="0" y1="400" x2="400" y2="400" stroke-dasharray="4,4" />
    <line x1="100" y1="0" x2="100" y2="500" stroke-dasharray="4,4" />
    <line x1="200" y1="0" x2="200" y2="500" stroke-dasharray="4,4" />
    <line x1="300" y1="0" x2="300" y2="500" stroke-dasharray="4,4" />
  </g>

  <!-- Glowing Aura -->
  <circle cx="200" cy="220" r="100" fill="#ff334b" opacity="0.12" filter="blur(30px)" />

  <!-- Stylized Developer Avatar Silhouette -->
  <g transform="translate(100, 110)">
    <!-- Head -->
    <circle cx="100" cy="80" r="45" fill="#2d2d38" stroke="url(#accentGrad)" stroke-width="3" />
    <!-- Glasses -->
    <rect x="75" y="70" width="20" height="14" rx="4" fill="#ff334b" opacity="0.8" />
    <rect x="105" y="70" width="20" height="14" rx="4" fill="#ff334b" opacity="0.8" />
    <line x1="95" y1="77" x2="105" y2="77" stroke="#ff334b" stroke-width="2" />
    <!-- Shoulders -->
    <path d="M 30 200 C 30 145, 60 135, 100 135 C 140 135, 170 145, 170 200 Z" fill="#24242e" stroke="#3d3d4e" stroke-width="2" />
  </g>

  <!-- Clean Typography Badge -->
  <g transform="translate(200, 420)">
    <rect x="-70" y="-16" width="140" height="32" rx="16" fill="#ff334b" opacity="0.15" stroke="#ff334b" stroke-width="1.5" />
    <text x="0" y="5" font-family="monospace" font-size="12" font-weight="bold" fill="#ff334b" text-anchor="middle" letter-spacing="2">ALRAF // DEV</text>
  </g>
</svg>
